+/*
+ * usbmtp_protected_name() (usbmtp patch)
+ *
+ * Names a connected computer may not create, rename an object to, or write to.
+ * KOReader runs Lua code it finds in the storage it shares (settings, the
+ * metadata files in each book's .sdr folder), so letting a USB host plant .lua
+ * files or .sdr folders, or rewrite hidden files, would let it run code as
+ * root on the Kindle the next time KOReader reads them.
+ *
+ * @return 1 if protected, 0 otherwise.
+ */
+static int usbmtp_ends_with_ci(const char *s, const char *suffix)
+{
+	size_t ls = strlen(s), lx = strlen(suffix);
+	if (ls < lx)
+		return 0;
+	return strcasecmp(s + ls - lx, suffix) == 0;
+}
+
+int usbmtp_protected_name(const char *name)
+{
+	if (!name)
+		return 0;
+	if (name[0] == '.')
+		return 1;
+	if (usbmtp_ends_with_ci(name, ".lua") || usbmtp_ends_with_ci(name, ".sdr"))
+		return 1;
+	return 0;
+}
